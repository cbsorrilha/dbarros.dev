---
import { render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageShell from "@/components/PageShell.astro";
import BackLink from "@/components/BackLink.astro";
import TagChip from "@/components/TagChip.astro";
import PostNav from "@/components/PostNav.astro";
import CodeCopy from "@/components/CodeCopy.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  getPostUrl,
  getPosts,
  getPublishedLocales,
  type Post,
} from "@/utils/posts";
import { formatDate, readingTime } from "@/utils/dates";
import { alternatesFor } from "@/utils/alternates";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";
import { LOCALES, tplStr, useTranslations, type Locale } from "@/i18n";

export async function getStaticPaths() {
  const paths = await Promise.all(
    LOCALES.map(async lang => {
      const posts = await getPosts(lang);
      // posts é do mais novo para o mais antigo: o anterior (mais antigo) tem
      // índice maior e o próximo (mais novo), menor.
      return posts.map((post, index) => ({
        params: { lang, slug: post.slug },
        props: {
          post,
          prevPost: posts[index + 1] ?? null,
          nextPost: posts[index - 1] ?? null,
        },
      }));
    })
  );
  return paths.flat();
}

type Props = {
  post: Post;
  prevPost: Post | null;
  nextPost: Post | null;
};

const { post, prevPost, nextPost } = Astro.props;
const lang = Astro.params.lang as Locale;

const { title, description, pubDate, updatedDate, tags } = post.entry.data;

const { Content } = await render(post.entry);
const t = useTranslations(lang);
const publishedLocales = getPublishedLocales(post.group);
const alternates = alternatesFor(`posts/${post.slug}/`, publishedLocales);
const translations = publishedLocales
  .filter(other => other !== lang)
  .map(other => ({
    lang: other,
    href: getPostUrl(post.slug, other),
    name: useTranslations(other).languageName,
  }));
const body = post.entry.body ?? "";
const hasCode = /^(```|~~~)/m.test(body);
const meta = `${formatDate(pubDate)} · ${tplStr(t.post.readingTime, {
  min: readingTime(body),
})}`;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  {description}
  {alternates}
  {pubDate}
  {updatedDate}
>
  <Header {alternates} />

  <PageShell width="reading">
    <BackLink
      href={getRelativeLocaleUrl(lang, "")}
      label={t.post.backToPosts}
    />

    <header class="post-header">
      <p class="meta">{meta}</p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      {
        (tags.length > 0 || translations.length > 0) && (
          <div class="tags-langs">
            {tags.length > 0 && (
              <ul class="chips">
                {tags.map(tag => (
                  <li>
                    <TagChip slug={slugifyStr(tag)} label={tag} {lang} />
                  </li>
                ))}
              </ul>
            )}
            {translations.length > 0 && (
              <p class="also-in">
                {t.post.alsoIn}{" "}
                {translations.map((tr, i) => (
                  <>
                    <a href={tr.href} hreflang={tr.lang} lang={tr.lang}>
                      {tr.name}
                    </a>
                    {i < translations.length - 2
                      ? ", "
                      : i === translations.length - 2
                        ? t.post.and
                        : ""}
                  </>
                ))}
              </p>
            )}
          </div>
        )
      }
    </header>

    <article id="article" class="app-prose">
      <Content />
    </article>

    <PostNav {lang} prev={prevPost} next={nextPost} />
  </PageShell>

  <Footer />
  {hasCode && <CodeCopy />}
</PostLayout>

<style>
  .post-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .meta {
    font-size: var(--fs-small);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  h1 {
    font-size: var(--fs-h1-post);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--text);
  }
  .lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--text-muted);
  }
  .tags-langs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .also-in {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .also-in a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .also-in a:hover {
    color: var(--link-hover);
  }
</style>
