---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageShell from "@/components/PageShell.astro";
import { alternatesFor } from "@/utils/alternates";
import { getRssUrl } from "@/utils/posts";
import { LOCALES, useTranslations, type Locale } from "@/i18n";
import config from "@/config";

export function getStaticPaths() {
  return LOCALES.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const about = await getEntry("pages", `about/${lang}`);
if (!about) {
  throw new Error(`Missing content entry: src/content/pages/about/${lang}.md`);
}
const { Content } = await render(about);

const socialLabels: Record<string, string> = {
  github: "GitHub",
  linkedin: "LinkedIn",
};
const links = [
  ...config.socials.map(({ name, url }) => ({
    label: socialLabels[name] ?? name,
    href: url,
    text: url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, ""),
  })),
  {
    label: t.footer.rss,
    href: getRssUrl(lang),
    text: `dbarros.dev${getRssUrl(lang)}`,
  },
];
const alternates = alternatesFor("about/");
---

<Layout
  title={`${t.nav.about} | ${config.site.title}`}
  description={about.data.description}
  {alternates}
>
  <Header {alternates} />

  <PageShell width="reading">
    <header class="about-header">
      <h1>{about.data.title}</h1>
      {about.data.description && <p class="lead">{about.data.description}</p>}
    </header>

    <article class="app-prose">
      <Content />
    </article>

    <dl class="links">
      {
        links.map(({ label, href, text }) => (
          <div>
            <dt>{label}</dt>
            <dd>
              <a {href}>{text}</a>
            </dd>
          </div>
        ))
      }
    </dl>
  </PageShell>

  <Footer />
</Layout>

<style>
  .about-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  h1 {
    font-size: var(--fs-h1-post);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.015em;
  }
  .lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--text-muted);
  }
  .links div {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
  }
  dt {
    color: var(--text-muted);
  }
  dd a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  dd a:hover {
    color: var(--link-hover);
  }
  @media (max-width: 640px) {
    .links div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
