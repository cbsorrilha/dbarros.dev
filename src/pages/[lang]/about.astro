---
import { getRssUrl } from "@/utils/posts";
import { getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { alternatesFor } from "@/utils/alternates";
import { LOCALES, useTranslations, type Locale } from "@/i18n";
import config from "@/config";

export function getStaticPaths() {
  return LOCALES.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const about = await getEntry("pages", `about/${lang}`);
if (!about) {
  throw new Error(`Missing content entry: src/content/pages/about/${lang}.md`);
}
const { Content } = await render(about);

const socialLabels: Record<string, string> = {
  github: "GitHub",
  linkedin: "LinkedIn",
};
const links = [
  ...config.socials.map(({ name, url }) => ({
    label: socialLabels[name] ?? name,
    href: url,
    text: url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, ""),
  })),
  {
    label: t.footer.rss,
    href: getRssUrl(lang),
    text: `dbarros.dev${getRssUrl(lang)}`,
  },
];
const alternates = alternatesFor("about/");
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  {alternates}
>
  <Header {alternates} />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <Content />

    <h2>{t.about.linksTitle}</h2>
    <ul>
      {
        links.map(({ label, href, text }) => (
          <li>
            {label}: <a {href}>{text}</a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
