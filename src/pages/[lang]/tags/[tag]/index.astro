---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageShell from "@/components/PageShell.astro";
import PageHeading from "@/components/PageHeading.astro";
import BackLink from "@/components/BackLink.astro";
import PostRow from "@/components/PostRow.astro";
import { getTagsInUse, postHasTag } from "@/utils/tags";
import { tagLabel, type TagSlug } from "@/content/tags";
import { getPosts, type Post } from "@/utils/posts";
import { alternatesFor } from "@/utils/alternates";
import { countLabel, LOCALES, useTranslations, type Locale } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  const postsByLang = new Map(
    await Promise.all(
      LOCALES.map(async lang => [lang, await getPosts(lang)] as const)
    )
  );

  // Uma página por tag e idioma, só onde a tag tem posts naquele idioma.
  return LOCALES.flatMap(lang => {
    const posts = postsByLang.get(lang) ?? [];
    return getTagsInUse(posts).map(tag => ({
      params: { lang, tag },
      props: {
        posts: posts.filter(post => postHasTag(post, tag)),
        tagLocales: LOCALES.filter(other =>
          (postsByLang.get(other) ?? []).some(post => postHasTag(post, tag))
        ),
      },
    }));
  });
}

type Props = { posts: Post[]; tagLocales: Locale[] };

const { posts, tagLocales } = Astro.props;
const lang = Astro.params.lang as Locale;
const tag = Astro.params.tag as TagSlug;
const t = useTranslations(lang);
const label = tagLabel(tag, lang);
const alternates = alternatesFor(`tags/${tag}/`, tagLocales);
// Cor da tag pelo token --tag-<slug> (obrigatório, checado no build).
const tagColor = `var(--tag-${tag})`;
---

<Layout title={`${label} | ${config.site.title}`} {alternates}>
  <Header {alternates} />

  <PageShell width="list">
    <div class="tag-page">
      <BackLink
        href={getRelativeLocaleUrl(lang, "tags/")}
        label={t.pages.backToTags}
      />
      <div class="heading">
        <PageHeading
          title={label}
          aside={countLabel(posts.length, t.pages.postCount)}
          color={tagColor}
        />
        <span class="bar" style={{ background: tagColor }}></span>
      </div>
      <ul>
        {posts.map(post => <PostRow {post} withYear />)}
      </ul>
    </div>
  </PageShell>

  <Footer />
</Layout>

<style>
  .tag-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .bar {
    display: block;
    width: 48px;
    height: 2px;
  }
</style>
