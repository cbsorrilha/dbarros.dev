---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import { getUniqueTags, postHasTag } from "@/utils/getUniqueTags";
import { getPosts, type Post } from "@/utils/posts";
import { alternatesFor } from "@/utils/alternates";
import { LOCALES, useTranslations, type Locale } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  const postsByLang = new Map(
    await Promise.all(
      LOCALES.map(async lang => [lang, await getPosts(lang)] as const)
    )
  );

  // Uma página por tag e idioma, só onde a tag tem posts naquele idioma.
  return LOCALES.flatMap(lang => {
    const posts = postsByLang.get(lang) ?? [];
    return getUniqueTags(posts).map(({ tag, tagName }) => ({
      params: { lang, tag },
      props: {
        tagName,
        posts: posts.filter(post => postHasTag(post, tag)),
        tagLocales: LOCALES.filter(other =>
          (postsByLang.get(other) ?? []).some(post => postHasTag(post, tag))
        ),
      },
    }));
  });
}

type Props = { tagName: string; posts: Post[]; tagLocales: Locale[] };

const { tagName, posts, tagLocales } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const alternates = alternatesFor(`tags/${Astro.params.tag}/`, tagLocales);
---

<Layout
  title={`${t.pages.tagTitle}: ${tagName} | ${config.site.title}`}
  {alternates}
>
  <Header {alternates} />

  <Breadcrumb />

  <Main
    pageTitle={`${t.pages.tagTitle}: ${tagName}`}
    pageDesc={`${t.pages.tagDesc} "${tagName}".`}
  >
    <ul>
      {posts.map(post => <Card {post} />)}
    </ul>
  </Main>

  <Footer />
</Layout>
