---
import TagChip from "./TagChip.astro";
import { getPostUrl, type Post } from "@/utils/posts";
import { formatShortDate, formatShortDateWithYear } from "@/utils/dates";

// Linha da listagem densa (Listagem 1a): data | título, resumo e chips.
// withYear: data com ano e coluna mais larga (página de tag).
type Props = { post: Post; withYear?: boolean };

const { post, withYear = false } = Astro.props;
const { title, description, pubDate, tags } = post.entry.data;
const date = withYear
  ? formatShortDateWithYear(pubDate, post.lang)
  : formatShortDate(pubDate, post.lang);
---

<li class:list={["row", { "with-year": withYear }]}>
  <time datetime={pubDate.toISOString()}>{date}</time>
  <div class="body">
    <a class="title" href={getPostUrl(post.slug, post.lang)}>{title}</a>
    <p class="desc">{description}</p>
    {
      tags.length > 0 && (
        <ul class="chips">
          {tags.map(tag => (
            <li>
              <TagChip slug={tag} lang={post.lang} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: var(--space-5);
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }
  .with-year {
    grid-template-columns: 96px 1fr;
  }
  time {
    padding-top: 4px;
    font-size: var(--fs-small);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .title {
    font-size: var(--fs-title-list);
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
    text-decoration: underline 1px var(--link-subtle);
    text-underline-offset: 5px;
  }
  .title:hover {
    color: var(--link);
    text-decoration-color: var(--link);
  }
  .desc {
    font-size: var(--fs-ui);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }
  @media (max-width: 640px) {
    .row,
    .with-year {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding: 18px 0;
    }
    time {
      padding-top: 0;
    }
  }
</style>
