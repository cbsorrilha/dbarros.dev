---
import { getRelativeLocaleUrl } from "astro:i18n";
import { tagLabel, type TagSlug } from "@/content/tags";
import type { Locale } from "@/i18n";

// Chip de tag: pílula com a cor da tag (texto, fundo 10%, borda 30%). A regra
// genérica .tag de vlad-tokens.css desenha a partir de --c, que vem do token.
type Props = {
  slug: TagSlug;
  lang: Locale;
  size?: "post" | "filter" | "index";
};

const { slug, lang, size = "post" } = Astro.props;
---

<a
  class:list={["tag", "chip", size]}
  data-tag={slug}
  style={`--c: var(--tag-${slug})`}
  href={getRelativeLocaleUrl(lang, `tags/${slug}/`)}>{tagLabel(slug, lang)}</a
>

<style>
  .chip {
    display: inline-block;
    border-radius: var(--radius-pill);
    font-size: var(--fs-chip);
    font-weight: 500;
    line-height: 1.5;
    padding: 1px 10px;
    white-space: nowrap;
  }
  .chip:hover {
    background: color-mix(in srgb, var(--c) 20%, transparent);
  }
  .filter {
    font-size: var(--fs-small);
    padding: 2px 12px;
  }
  .index {
    font-size: 16px;
  }
</style>
