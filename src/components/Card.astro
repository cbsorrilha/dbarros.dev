---
import { getPostUrl, type Post } from "@/utils/posts";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  post: Post;
};

const { variant: Heading = "h2", post } = Astro.props;

const { title, description, pubDate, updatedDate } = post.entry.data;
---

<li class="my-6">
  <a
    href={getPostUrl(post.slug, post.lang)}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading>
      {title}
    </Heading>
  </a>
  <Datetime {pubDate} {updatedDate} />
  <p>{description}</p>
</li>
