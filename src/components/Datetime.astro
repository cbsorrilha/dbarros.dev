---
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { getLocale, useTranslations } from "@/i18n";

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDate: Date;
  updatedDate?: Date;
};

const {
  pubDate,
  updatedDate,
  size = "sm",
  class: className = "",
} = Astro.props;

const lang = getLocale(Astro);
const t = useTranslations(lang);

const isModified = !!updatedDate && updatedDate > pubDate;
const date = isModified ? updatedDate : pubDate;

// Datas sem hora no front matter (ex.: 2026-10-01) chegam como meia-noite UTC e
// representam um dia do calendário: exibir em UTC, senão viram o dia anterior.
const isDateOnly =
  date.getUTCHours() === 0 &&
  date.getUTCMinutes() === 0 &&
  date.getUTCSeconds() === 0;

const formatted = new Intl.DateTimeFormat(lang, {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: isDateOnly ? "UTC" : config.site.timezone,
}).format(date);
---

<div
  class:list={["text-muted-foreground flex items-center gap-x-2", className]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  {
    isModified && (
      <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
        {t.post.updatedAt}:
      </span>
    )
  }
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={date.toISOString()}
  >
    {formatted}
  </time>
</div>
