---
import { getPostUrl, type Post } from "@/utils/posts";
import { useTranslations, type Locale } from "@/i18n";

// Anterior (mais antigo) e próximo (mais novo) no mesmo idioma (Post 1a/1b).
type Props = { lang: Locale; prev: Post | null; next: Post | null };

const { lang, prev, next } = Astro.props;
const t = useTranslations(lang);
---

{
  (prev || next) && (
    <nav class="post-nav">
      {prev && (
        <a class="item" href={getPostUrl(prev.slug, lang)}>
          <span class="label">← {t.post.previousPost}</span>
          <span class="title">{prev.entry.data.title}</span>
        </a>
      )}
      {next && (
        <a class="item next" href={getPostUrl(next.slug, lang)}>
          <span class="label">{t.post.nextPost} →</span>
          <span class="title">{next.entry.data.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: 40px;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: 18px 20px;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--border);
    color: var(--text);
  }
  .item:hover {
    box-shadow: inset 0 0 0 1px var(--link);
  }
  .next {
    grid-column: 2;
    text-align: end;
  }
  .label {
    font-size: var(--fs-chip);
    color: var(--text-muted);
  }
  .title {
    font-size: 18px;
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
    .next {
      grid-column: 1;
      text-align: start;
    }
  }
</style>
