---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageShell from "@/components/PageShell.astro";
import { alternatesFor } from "@/utils/alternates";
import { tplStr, useTranslations, type Locale } from "@/i18n";
import config from "@/config";

// 404 do tema Vlad (Mobile e 404, 1d/1e). Estática, sem script: o build gera uma
// por idioma e uma por tradução ausente (com readIn), e o Cloudflare Pages serve a
// mais próxima do caminho pedido.
type Props = {
  lang: Locale;
  readIn?: { lang: Locale; href: string };
};

const { lang, readIn } = Astro.props;
const t = useTranslations(lang);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`} alternates={[]}>
  <meta slot="head" name="robots" content="noindex" />
  <Header alternates={alternatesFor("")} />

  <PageShell width="center">
    <div class="not-found">
      <p class="code" aria-hidden="true">404</p>
      <h1>{t.notFound.title}</h1>
      <p class="message">{t.notFound.message}</p>
      <div class="actions">
        <a class="primary" href={getRelativeLocaleUrl(lang, "")}
          >{t.notFound.goHome}</a
        >
        {
          readIn && (
            <a
              class="secondary"
              href={readIn.href}
              hreflang={readIn.lang}
              lang={readIn.lang}
            >
              {tplStr(t.notFound.readIn, {
                lang: useTranslations(readIn.lang).languageName,
              })}
            </a>
          )
        }
      </div>
    </div>
  </PageShell>

  <Footer />
</Layout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 560px;
    padding: var(--space-7) 0;
    text-align: center;
  }
  .code {
    font-size: 128px;
    font-weight: 700;
    line-height: 1;
    color: var(--link);
    text-shadow: 0 0 32px color-mix(in srgb, var(--link) 35%, transparent);
  }
  h1 {
    font-size: 36px;
    font-weight: 600;
    line-height: var(--lh-tight);
  }
  .message {
    font-size: var(--fs-ui);
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border-radius: var(--radius-md);
    font-size: var(--fs-ui);
    font-weight: 600;
  }
  .primary {
    background: var(--link);
    color: var(--bg);
  }
  .primary:hover {
    background: var(--link-hover);
  }
  .secondary {
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .secondary:hover {
    box-shadow: inset 0 0 0 1px var(--link);
  }
  @media (max-width: 640px) {
    .code {
      font-size: 88px;
    }
    h1 {
      font-size: 28px;
    }
    .actions {
      flex-direction: column;
      align-self: stretch;
    }
    .actions a {
      min-height: 48px;
    }
  }
</style>
