---
import { getRelativeLocaleUrl } from "astro:i18n";
import Logo from "./Logo.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { getLocale, useTranslations } from "@/i18n";
import type { Alternate } from "@/utils/alternates";

type Props = {
  /** Idiomas em que a página atual existe; o seletor só mostra estes. */
  alternates: Alternate[];
};

const { alternates } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);
const languages = alternates.map(alt => ({
  ...alt,
  short: useTranslations(alt.lang).languageShort,
  name: useTranslations(alt.lang).languageName,
}));

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
const relativePath = stripBase(Astro.url.pathname);
const currentPath = stripLocale(relativePath.replace(/(.)\/$/, "$1"), locale);
// A home do idioma é a lista de posts: "Posts" fica ativo nela também.
const currentSection = currentPath.split("/").filter(Boolean)[0] ?? "posts";

const navItems = [
  { section: "posts", path: "", label: t.nav.posts },
  { section: "tags", path: "tags", label: t.nav.tags },
  { section: "about", path: "about", label: t.nav.about },
];
---

<a id="skip-to-content" href="#main-content" class="skip-link">
  {t.a11y.skipToContent}
</a>

<header class="site-header">
  <Logo href={getRelativeLocaleUrl(locale, "")} label={t.a11y.homeLink} />

  <div class="header-end">
    <nav class="site-nav">
      <button
        id="menu-btn"
        class="menu-btn"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <span></span><span></span><span></span>
      </button>
      <ul id="menu-items" class="menu-items">
        {
          navItems.map(({ section, path, label }) => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, path)}
                class:list={{ "active-nav": currentSection === section }}
                aria-current={currentSection === section ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="lang-switch" aria-label={t.nav.language}>
      <ul>
        {
          languages.map(({ lang, href, short, name }) => (
            <li>
              <a
                {href}
                hreflang={lang}
                lang={lang}
                title={name}
                aria-current={lang === locale ? "true" : undefined}
              >
                {short}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-4);
    top: -100%;
    z-index: 50;
    padding: var(--space-2) var(--space-3);
    background: var(--bg-deep);
    color: var(--link);
  }
  .skip-link:focus {
    top: var(--space-4);
  }

  .site-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: 28px var(--space-8);
    border-bottom: 1px solid var(--border);
    /* Respiro até o conteúdo (design: 64px; 28px no celular). */
    margin-bottom: var(--space-8);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .lang-switch ul {
    display: flex;
    gap: var(--space-1);
    padding: 3px;
    background: var(--bg-deep);
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .lang-switch a {
    display: block;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-chip);
    font-weight: 600;
    color: var(--text-muted);
  }
  .lang-switch a:hover {
    color: var(--text);
  }
  .lang-switch a[aria-current] {
    background: var(--surface);
    color: var(--text);
  }

  .menu-items {
    display: flex;
    gap: var(--space-6);
    font-size: var(--fs-ui);
  }
  .menu-items a {
    color: var(--text-muted);
  }
  .menu-items a:hover,
  .menu-items a.active-nav {
    color: var(--text);
  }

  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: none;
    border: 0;
  }
  .menu-btn span {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--text);
  }

  @media (max-width: 640px) {
    .site-header {
      padding: 14px 20px;
      margin-bottom: 28px;
    }
    .menu-btn {
      display: flex;
    }
    .header-end {
      flex-direction: row-reverse;
      gap: var(--space-3);
    }
    .menu-items {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      z-index: 40;
      flex-direction: column;
      gap: 0;
      padding: var(--space-2) 20px var(--space-5);
      background: var(--bg-deep);
      border-bottom: 1px solid var(--border);
    }
    .menu-items.open {
      display: flex;
    }
    .menu-items a {
      display: block;
      padding: var(--space-3) 0;
    }
  }
</style>

<script>
  // Move o foco para o conteúdo, não só a rolagem, ao usar "Pular para o conteúdo".
  const skipLink = document.getElementById("skip-to-content");
  skipLink?.addEventListener("click", e => {
    if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.button)
      return;
    const target = document.getElementById("main-content");
    if (!target) return;
    e.preventDefault();
    target.setAttribute("tabindex", "-1");
    target.addEventListener("blur", () => target.removeAttribute("tabindex"), {
      once: true,
    });
    target.focus();
    target.scrollIntoView();
  });

  const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
  const menuItems = document.querySelector("#menu-items");

  if (menuBtn && menuItems) {
    const openLabel = menuBtn.dataset.labelOpen ?? "";
    const closeLabel = menuBtn.dataset.labelClose ?? "";

    menuBtn.addEventListener("click", () => {
      const open = menuBtn.getAttribute("aria-expanded") !== "true";
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute("aria-label", open ? closeLabel : openLabel);
      menuItems.classList.toggle("open", open);
    });
  }
</script>
